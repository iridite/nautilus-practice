# ============================================================================
# Optimization System Environment Variables
# ============================================================================
#
# 使用说明:
# 1. 复制此文件为 .env
#    cp .env.example .env
#
# 2. 填写实际的 API Key 和配置
#
# 3. 运行测试验证配置
#    uv run python scripts/quick_diagnose.py
#
# ============================================================================

# ===== API 配置 =====

# Anthropic API Key
# 从 https://console.anthropic.com/ 或者你的 API 提供商处获取
ANTHROPIC_KEY=sk-your-api-key-here

# Anthropic API Base URL
# 默认: https://api.anthropic.com
# 第三方代理: https://uapi.chat 或其他
# 注意: 必须包含 http:// 或 https:// 前缀
ANTHROPIC_BASE_URL=https://uapi.chat

# 可用的模型列表（逗号分隔）
# 用于验证模型是否在允许的列表中
USABLE_MODEL=claude-sonnet-4-5-20250929,claude-haiku-4-5-20251001,gemini-3-pro-preview,gemini-3-pro,claude-sonnet-4-20250514

# ===== 其他 API 配置（可选） =====

# SiliconFlow API (如果使用)
# SF_API_KEY=your-siliconflow-api-key
# SF_BASE_URL=https://api.siliconflow.cn/v1

# ===== LangSmith 配置（可选） =====

# LangSmith API Key (用于追踪和调试)
# LANGCHAIN_API_KEY=your-langsmith-api-key
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=nautilus-practice

# ===== 调试配置（可选） =====

# 启用详细日志
# LANGCHAIN_VERBOSE=true

# ============================================================================
# 注意事项:
# - .env 文件包含敏感信息，不应提交到版本控制系统
# - 确保 .env 已添加到 .gitignore
# - Base URL 必须包含协议头 (http:// 或 https://)
# - API Key 不要有引号，直接填写即可
# ============================================================================
